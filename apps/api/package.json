{
    "name":  "@triageforge/api",
    "version":  "0.1.0",
    "private":  true,
    "description":  "TriageForge Express API",
    "type":  "module",
    "dependencies":  {
                         "express":  "^5.2.1",
                         "helmet":  "^8.3.0",
                         "pino":  "^10.3.1",
                         "pino-http":  "^11.0.0"
                     },
    "devDependencies":  {
                            "@types/express":  "^5.0.6",
                            "@types/node":  "^26.1.2",
                            "@types/supertest":  "^7.2.1",
                            "supertest":  "^7.2.2",
                            "tsx":  "^4.23.6",
                            "typescript":  "^7.0.2",
                            "vitest":  "^4.1.10"
                        },
    "scripts":  {
                    "dev":  "tsx watch src/server.ts",
                    "build":  "tsc -p tsconfig.json",
                    "start":  "node dist/server.js",
                    "typecheck":  "tsc -p tsconfig.json --noEmit \u0026\u0026 tsc -p tsconfig.test.json --noEmit",
                    "test":  "vitest run",
                    "test:watch":  "vitest"
                }
}
