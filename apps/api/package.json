{
    "name": "@triageforge/api",
    "version": "0.1.0",
    "private": true,
    "description": "TriageForge Express API",
    "type": "module",
    "dependencies": {
        "@triageforge/contracts": "workspace:*",
        "cookie": "^2.0.1",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.2",
        "helmet": "^8.3.0",
        "pg": "^8.22.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/cookie": "^1.0.0",
        "@types/express": "^5.0.6",
        "@types/node": "^26.1.2",
        "@types/pg": "^8.20.4",
        "@types/supertest": "^7.2.1",
        "supertest": "^7.2.2",
        "tsx": "^4.23.6",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "db:migrate": "tsx src/infrastructure/database/migrate.ts"
    }
}
