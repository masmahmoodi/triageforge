# Server
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgres://triageforge:triageforge@127.0.0.1:54329/triageforge

# Sessions
SESSION_COOKIE_NAME=triageforge_session
# For separate production frontend/API domains, use SESSION_COOKIE_SAMESITE=none.
# For subdomains on one parent domain, set SESSION_COOKIE_DOMAIN=.example.com.
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_DAYS=14
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# GitHub App
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Prefer base64 so multiline PEM formatting survives dotenv parsing.
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRIAGE_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
